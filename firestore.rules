rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // News is public to read. Only an allow-listed admin can create/update/delete it.
    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 600
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Users can read their own allow-list entry; only project owner should create admins in Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
